# pmukit is a TOOL-ONLY public repo. Real designs, measurements, manifests and delivered
# models NEVER enter git -- they live outside the tree (see README "Data rule").
data/
work*/
runs/
deliver/
# Any local $PMUKIT_DATA scratch area. These hold real measurements the moment someone points
# pmukit at a real bench, so they are ignored by NAME, not by hoping nobody creates one.
.tmpdata/
pmukit_data/
*_data/
.pmukit_scratch/
.venv/
__pycache__/
*.pyc
*.psf
*.psfbin
*.raw
*.log
*.npz
!tests/fixtures/**/*.npz
dist/
build/
.pmukit-denylist
.DS_Store
design/pmukit-screens.html
